{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:base", ":semanticCommitTypeAll(chore)"],
  "minimumReleaseAge": "3 days",
  "schedule": ["every weekday before 11am"],
  "semanticCommits": "enabled",
  "dependencyDashboard": true,
  "packageRules": [
    {
      "matchPackageNames": ["@ionic/**"],
      "minimumReleaseAge": "0 days",
      "groupName": "ionic"
    },
    {
      "matchPackageNames": ["vue", "@vitejs/plugin-vue"],
      "groupName": "vue"
    },
    {
      "matchPackageNames": ["@capacitor/**"],
      "groupName": "capacitor"
    },
    {
      "matchPackageNames": ["vite"],
      "groupName": "vite"
    },
    {
      "matchPackageNames": ["vitest", "cypress", "@vue/test-utils"],
      "groupName": "testing"
    },
    {
      "matchPackageNames": ["eslint", "typescript"],
      "groupName": "dev-tools"
    }
  ]
}
